# Copy to .env.local and change both values. The sample values below are refused on purpose.

# The password for /signin, which unlocks /results and the CSV downloads. 8 characters or more.
SURVEY_ADMIN_PASSWORD=change-me

# A random string of 32 characters or more. Signs the sign-in cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SURVEY_SECRET=replace-with-a-long-random-string

# Where the database file lives (default: ./data). On a host, point this at a persistent disk.
# DATA_DIR=./data

# Set to 1 when the site runs behind a host's proxy (Railway, Render, Fly), so wrong passwords are limited per
# visitor. Leave unset on your own computer.
# TRUST_PROXY=1
