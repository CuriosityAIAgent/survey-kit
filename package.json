  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "^22.20.4",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "postcss": "^8.5.28",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "4.1.13",
